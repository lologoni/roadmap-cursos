# =============================================================
# Rumbo — .gitignore
# Monorepo: frontend (React + Vite + pnpm) · backend (FastAPI + uv)
# =============================================================

# ---------- Secretos y entorno ----------
.env
.env.*
!.env.example
*.pem
*.key

# ---------- Sistema operativo / editores ----------
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ---------- Frontend: Node / pnpm / Vite ----------
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/coverage/
*.local
*.tsbuildinfo
.eslintcache
.stylelintcache
# El lockfile SÍ se versiona: pnpm-lock.yaml

# ---------- Backend: Python / uv ----------
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.python-version.local
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
# El lockfile SÍ se versiona: uv.lock

# ---------- Docker / datos locales ----------
docker-compose.override.yml
pgdata/
*.sql.gz
*.dump

# ---------- Logs ----------
logs/
*.log
