# =============================================================
# Rumbo — variables de entorno (TRD §4.4)
# Copiar a .env antes de levantar el stack:  cp .env.example .env
# Los valores de este archivo son SOLO para desarrollo local.
# =============================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=rumbo
POSTGRES_PASSWORD=cambiar-en-local
POSTGRES_DB=rumbo

# ---------- Backend ----------
DATABASE_URL=postgresql+psycopg://rumbo:cambiar-en-local@postgres:5432/rumbo
DATABASE_URL_TEST=postgresql+psycopg://rumbo:cambiar-en-local@postgres:5432/rumbo_test
# Mínimo 32 bytes. Generar uno propio con: openssl rand -hex 32
JWT_SECRET=solo-desarrollo-reemplazar-con-openssl-rand-hex-32-0123456789abcdef
JWT_EXPIRA_MINUTOS=60
# false solo en desarrollo (HTTP sin TLS)
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173
RECUPERACION_EXPIRA_MINUTOS=30
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_REMITENTE=Rumbo <no-responder@rumbo.local>
# Admin inicial que crea el script de datos de demo
ADMIN_EMAIL=admin@rumbo.local
ADMIN_PASSWORD=cambiar-en-local-2026
# Vacío en desarrollo: el frontend usa el proxy de Vite (TD-013)
CORS_ORIGINS=
LOG_LEVEL=INFO

# ---------- Frontend ----------
VITE_PROXY_TARGET=http://backend:8000
